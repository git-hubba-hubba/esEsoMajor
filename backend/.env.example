PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ssoplus

# The live guide is opt-in. Sandbox is the default and does not consume credits.
LIVEAVATAR_API_KEY=
LIVEAVATAR_SANDBOX=true
# Optional: otherwise resolved once from the selected avatar's default voice.
LIVEAVATAR_VOICE_ID=
# Only required when sandbox is false.
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_MAX_SECONDS=120
LIVEAVATAR_DAILY_SESSION_LIMIT=2
